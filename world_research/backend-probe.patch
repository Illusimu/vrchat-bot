+async function runWorldResearchProbe(env: Env, scheduledTime: number) {
+  if (scheduledTime >= Date.parse('2026-11-17T17:00:00Z')) return false;
+  const claim = await env.DB.prepare(
+    "INSERT OR IGNORE INTO integration_state(name,value,updated_at) VALUES ('world_research_one_shot_20261117','running',?)",
+  ).bind(now()).run();
+  if (!claim.meta.changes) return false;
+  let result: unknown;
+  try {
+    result = await activeWorldResearchSnapshot(env);
+  } catch (error) {
+    if (error instanceof HttpError && error.status === 429) {
+      await env.DB.prepare("DELETE FROM integration_state WHERE name='world_research_one_shot_20261117' AND value='running'").run();
+      return false;
+    }
+    result = {error:error instanceof HttpError ? error.message : 'Unexpected probe failure.'};
+  }
+  await env.DB.prepare("UPDATE integration_state SET value=?, updated_at=? WHERE name='world_research_one_shot_20261117'")
+    .bind(JSON.stringify(result), now()).run();
+  return true;
+}

+export async function worldResearchPage(env: Env, pool: string | null, page: string | null) {
+  const tags = new Map([['games', 'author_tag_game'], ['hangouts', 'author_tag_social,author_tag_hangout']]);
+  if (!pool || (pool !== 'active' && pool !== 'published' && !tags.has(pool))) throw new HttpError(400, 'Unknown world pool.');
+  if (page !== '1' && (page !== '2' || pool === 'published')) throw new HttpError(400, 'Invalid world page.');
+  const published = pool === 'published';
+  const limit = published ? 50 : 100;
+  const offset = (Number(page) - 1) * limit;
+  const sort = published ? 'publicationDate' : 'popularity';
+  const parameters = new URLSearchParams({releaseStatus:'public', sort, order:'descending', n:String(limit), offset:String(offset)});
+  const tag = tags.get(pool);
+  if (tag) parameters.set('tag', tag);
+  const path = published ? '/worlds' : '/worlds/active';
+  return vrchatGet(env, `${path}?${parameters}`, raw => ({
+    version:2, pool, sort, page:Number(page), limit, offset, observedAt:new Date(now()).toISOString(),
+    worlds:researchWorlds(raw, limit),
+  }), 60_000);
+}
